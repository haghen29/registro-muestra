# Conexión a MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=muestra_user
DB_PASSWORD=test1234
DB_NAME=muestra_tec4
# true si el proveedor de la base exige SSL (Aiven, Railway, etc.)
DB_SSL=false

# PIN inicial del panel /admin (solo números, 4 a 8 cifras).
# Se usa la primera vez; después el admin lo cambia desde el panel y queda guardado cifrado en la base.
ADMIN_PIN=1111

# Detector de registros sospechosos: on / off
DETECTOR_TROLL=on
